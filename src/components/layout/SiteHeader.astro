---
const navigationItems = [
  { href: '/#gioi-thieu', label: 'Giới thiệu' },
  { href: '/interview/', label: '48 câu hỏi' },
];
---

<header class="border-b border-slate-200 bg-white/90 dark:border-slate-800 dark:bg-slate-950/90">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4 sm:px-8">
    <a
      href="/"
      class="rounded-sm text-base font-bold tracking-tight text-slate-950 outline-offset-4 hover:text-cyan-700 focus-visible:outline-2 focus-visible:outline-cyan-600 dark:text-white dark:hover:text-cyan-300"
    >
      DE Interview
    </a>
    <nav aria-label="Điều hướng chính">
      <ul class="flex items-center gap-5 text-sm font-medium text-slate-700 dark:text-slate-300">
        {
          navigationItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded-sm outline-offset-4 hover:text-cyan-700 focus-visible:outline-2 focus-visible:outline-cyan-600 dark:hover:text-cyan-300"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
