---
import '../styles/global.css';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';

interface Props {
  description: string;
  title: string;
}

const { description, title } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="Data Engineering Interview Blog" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Data Engineering Interview Blog RSS"
      href="/rss.xml"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
  </head>
  <body
    class="min-h-screen bg-white text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100"
  >
    <a
      href="#main-content"
      class="sr-only fixed left-4 top-4 z-50 rounded-md bg-cyan-700 px-4 py-2 font-semibold text-white outline-offset-4 focus:not-sr-only focus-visible:outline-2 focus-visible:outline-cyan-300"
    >
      Chuyển đến nội dung chính
    </a>
    <div class="flex min-h-screen flex-col">
      <SiteHeader />
      <slot />
      <SiteFooter />
    </div>
  </body>
</html>
