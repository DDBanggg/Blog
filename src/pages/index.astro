---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Data Engineering Interview Blog';
const description = 'Nền tảng blog tĩnh cho bộ 48 câu hỏi phỏng vấn Data Engineer.';
---

<BaseLayout title={title} description={description}>
  <main id="main-content" class="mx-auto w-full max-w-6xl px-6 py-20 sm:px-8 sm:py-28">
    <section id="gioi-thieu" aria-labelledby="project-title" class="max-w-3xl space-y-6">
      <p class="text-sm font-semibold tracking-wide text-cyan-700 dark:text-cyan-300">
        Data Engineering
      </p>
      <h1 id="project-title" class="text-4xl font-bold tracking-tight sm:text-5xl">{title}</h1>
      <p class="max-w-2xl text-lg leading-8 text-slate-700 dark:text-slate-300">
        Nơi chia sẻ kiến thức và hệ thống hoá các câu hỏi phỏng vấn dành cho Data Engineer.
      </p>
      <p class="text-sm font-medium text-cyan-800 dark:text-cyan-200">
        Nền tảng nội dung đã sẵn sàng
      </p>
    </section>
    <section
      id="noi-dung"
      aria-labelledby="content-title"
      class="mt-16 max-w-3xl border-t border-slate-200 pt-10 dark:border-slate-800"
    >
      <h2 id="content-title" class="text-2xl font-bold tracking-tight">Nội dung đang phát triển</h2>
      <p class="mt-4 leading-7 text-slate-700 dark:text-slate-300">
        Bộ 48 câu hỏi đã được chuẩn hoá thành Markdown. Trang danh sách và trang đọc từng câu hỏi sẽ
        được bổ sung ở phase tiếp theo.
      </p>
    </section>
  </main>
</BaseLayout>
