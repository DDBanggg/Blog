---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Data Engineering Interview Blog';
const description = 'Nền tảng blog tĩnh cho bộ 48 câu hỏi phỏng vấn Data Engineer.';
---

<BaseLayout title={title} description={description}>
  <main class="mx-auto flex min-h-screen max-w-3xl items-center px-6 py-16 sm:px-8">
    <section aria-labelledby="project-title" class="space-y-6">
      <p class="text-sm font-semibold tracking-wide text-cyan-700 dark:text-cyan-300">
        Data Engineering
      </p>
      <h1 id="project-title" class="text-4xl font-bold tracking-tight sm:text-5xl">{title}</h1>
      <p class="max-w-2xl text-lg leading-8 text-slate-700 dark:text-slate-300">
        Nơi chia sẻ kiến thức và hệ thống hoá các câu hỏi phỏng vấn dành cho Data Engineer.
      </p>
      <p
        class="inline-flex rounded-md bg-cyan-100 px-3 py-2 text-sm font-medium text-cyan-900 dark:bg-cyan-950 dark:text-cyan-100"
      >
        Project foundation initialized
      </p>
      <p class="text-slate-600 dark:text-slate-400">
        Nội dung của 48 câu hỏi sẽ được bổ sung ở các bước tiếp theo.
      </p>
    </section>
  </main>
</BaseLayout>
