---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortInterviewEntries } from '../../utils/interview';

const entries = sortInterviewEntries(await getCollection('interview'));
const title = '48 câu hỏi phỏng vấn Data Engineer';
const description = 'Danh sách 48 câu hỏi phỏng vấn Data Engineer theo chủ đề.';
---

<BaseLayout title={title} description={description}>
  <main id="main-content" class="mx-auto w-full max-w-6xl px-6 py-16 sm:px-8 sm:py-20">
    <header class="max-w-3xl">
      <p class="text-sm font-semibold tracking-wide text-cyan-700 dark:text-cyan-300">
        Interview library
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">{title}</h1>
      <p class="mt-5 text-lg leading-8 text-slate-700 dark:text-slate-300">{description}</p>
    </header>

    <div class="mt-10 max-w-3xl">
      <label
        for="interview-search"
        class="text-sm font-semibold text-slate-900 dark:text-slate-100"
      >
        Tìm kiếm trong 48 câu hỏi
      </label>
      <input
        id="interview-search"
        type="search"
        placeholder="Ví dụ: Hadoop, SQL, data pipeline..."
        autocomplete="off"
        class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-offset-4 placeholder:text-slate-500 focus:border-cyan-600 focus-visible:outline-2 focus-visible:outline-cyan-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:placeholder:text-slate-400"
      />
      <p
        id="search-status"
        class="mt-3 text-sm text-slate-600 dark:text-slate-400"
        aria-live="polite"
      >
        Nhập từ khoá để tìm trong tiêu đề, tag và nội dung bài viết.
      </p>
    </div>

    <ol
      id="interview-list"
      class="mt-12 grid gap-4 sm:grid-cols-2"
      aria-label="Danh sách câu hỏi phỏng vấn"
    >
      {
        entries.map((entry) => (
          <li data-interview-id={entry.id}>
            <a
              href={`/interview/${entry.id}`}
              class="group flex h-full flex-col rounded-xl border border-slate-200 bg-white p-6 outline-offset-4 transition-colors hover:border-cyan-500 hover:bg-cyan-50 focus-visible:outline-2 focus-visible:outline-cyan-600 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-cyan-400 dark:hover:bg-slate-900"
            >
              <div class="flex items-center justify-between gap-4 text-sm">
                <span class="font-semibold text-cyan-700 dark:text-cyan-300">
                  Câu {entry.data.questionNumber.toString().padStart(2, '0')}
                </span>
                {entry.data.draft && (
                  <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-medium text-amber-900 dark:bg-amber-950 dark:text-amber-100">
                    Bản nháp
                  </span>
                )}
              </div>
              <h2 class="mt-4 text-xl font-semibold tracking-tight group-hover:text-cyan-800 dark:group-hover:text-cyan-200">
                {entry.data.title}
              </h2>
              <p class="mt-3 leading-7 text-slate-700 dark:text-slate-300">
                {entry.data.description}
              </p>
              <div
                class="mt-5 flex flex-wrap gap-2"
                aria-label={`Nhãn cho câu ${entry.data.questionNumber}`}
              >
                <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                  {entry.data.category}
                </span>
                {entry.data.tags.map((tag) => (
                  <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    #{tag}
                  </span>
                ))}
              </div>
            </a>
          </li>
        ))
      }
    </ol>
  </main>
</BaseLayout>

<script>
  type SearchEntry = {
    id: string;
    searchText: string;
  };

  const input = document.querySelector<HTMLInputElement>('#interview-search');
  const status = document.querySelector<HTMLParagraphElement>('#search-status');
  const cards = Array.from(document.querySelectorAll<HTMLLIElement>('[data-interview-id]'));
  const normalize = (value: string) =>
    value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLocaleLowerCase('vi-VN');

  if (input && status) {
    const searchIndex = await fetch('/search-index.json').then(async (response) => {
      if (!response.ok) {
        throw new Error('Không thể tải chỉ mục tìm kiếm.');
      }

      return (await response.json()) as SearchEntry[];
    });
    const searchableEntries = new Map(
      searchIndex.map((entry) => [entry.id, normalize(entry.searchText)]),
    );

    input.addEventListener('input', () => {
      const query = normalize(input.value.trim());
      const terms = query.split(/\s+/).filter(Boolean);
      let visibleCount = 0;

      for (const card of cards) {
        const searchableText = searchableEntries.get(card.dataset.interviewId ?? '') ?? '';
        const matches = terms.every((term) => searchableText.includes(term));
        const isVisible = terms.length === 0 || matches;

        card.hidden = !isVisible;
        visibleCount += Number(isVisible);
      }

      status.textContent =
        terms.length === 0 ? 'Hiển thị tất cả 48 câu hỏi.' : `Tìm thấy ${visibleCount} câu hỏi.`;
    });
  }
</script>
