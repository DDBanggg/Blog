---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  formatInterviewDate,
  sortInterviewEntries,
  type InterviewEntry,
} from '../../utils/interview';

export async function getStaticPaths() {
  const entries = sortInterviewEntries(await getCollection('interview'));

  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      nextEntry: entries[index + 1] ?? null,
      previousEntry: entries[index - 1] ?? null,
    },
  }));
}

interface Props {
  entry: InterviewEntry;
  nextEntry: InterviewEntry | null;
  previousEntry: InterviewEntry | null;
}

const { entry, nextEntry, previousEntry } = Astro.props;
const { Content, headings } = await render(entry);
const title = `${entry.data.title} | Data Engineering Interview Blog`;
---

<BaseLayout title={title} description={entry.data.description}>
  <main id="main-content" class="mx-auto w-full max-w-6xl px-6 py-12 sm:px-8 sm:py-16">
    <a
      href="/interview/"
      class="inline-flex rounded-sm text-sm font-medium text-cyan-700 outline-offset-4 hover:text-cyan-900 focus-visible:outline-2 focus-visible:outline-cyan-600 dark:text-cyan-300 dark:hover:text-cyan-100"
    >
      ← Tất cả câu hỏi
    </a>

    <div class="mt-8 grid gap-12 lg:grid-cols-[minmax(0,1fr)_15rem]">
      <article class="min-w-0">
        <header class="border-b border-slate-200 pb-8 dark:border-slate-800">
          <div class="flex flex-wrap items-center gap-3 text-sm">
            <span class="font-semibold text-cyan-700 dark:text-cyan-300">
              Câu {entry.data.questionNumber.toString().padStart(2, '0')}
            </span>
            <span class="text-slate-500 dark:text-slate-400">{entry.data.category}</span>
            {
              entry.data.draft && (
                <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-medium text-amber-900 dark:bg-amber-950 dark:text-amber-100">
                  Bản nháp
                </span>
              )
            }
          </div>
          <h1 class="mt-5 text-3xl font-bold tracking-tight sm:text-4xl">{entry.data.title}</h1>
          <p class="mt-5 text-lg leading-8 text-slate-700 dark:text-slate-300">
            {entry.data.description}
          </p>
          <dl
            class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-600 dark:text-slate-400"
          >
            <div class="flex gap-2">
              <dt class="font-medium text-slate-900 dark:text-slate-100">Xuất bản:</dt>
              <dd>{formatInterviewDate(entry.data.publishedAt)}</dd>
            </div>
            {
              entry.data.updatedAt && (
                <div class="flex gap-2">
                  <dt class="font-medium text-slate-900 dark:text-slate-100">Cập nhật:</dt>
                  <dd>{formatInterviewDate(entry.data.updatedAt)}</dd>
                </div>
              )
            }
          </dl>
          <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tags">
            {
              entry.data.tags.map((tag) => (
                <li class="rounded-full bg-slate-100 px-2.5 py-1 text-xs text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                  #{tag}
                </li>
              ))
            }
          </ul>
        </header>

        <div class="article-content mt-10">
          <Content />
        </div>

        {
          entry.data.sourceUrl && (
            <p class="mt-10 border-t border-slate-200 pt-6 text-sm text-slate-600 dark:border-slate-800 dark:text-slate-400">
              Nguồn:{' '}
              <a
                href={entry.data.sourceUrl}
                rel="noreferrer"
                class="text-cyan-700 underline underline-offset-4 dark:text-cyan-300"
              >
                {entry.data.sourceName ?? entry.data.sourceUrl}
              </a>
            </p>
          )
        }

        <nav
          class="mt-12 grid gap-4 border-t border-slate-200 pt-8 sm:grid-cols-2 dark:border-slate-800"
          aria-label="Điều hướng câu hỏi"
        >
          {
            previousEntry ? (
              <a
                href={`/interview/${previousEntry.id}`}
                class="rounded-lg border border-slate-200 p-4 outline-offset-4 hover:border-cyan-500 hover:bg-cyan-50 focus-visible:outline-2 focus-visible:outline-cyan-600 dark:border-slate-800 dark:hover:border-cyan-400 dark:hover:bg-slate-900"
              >
                <span class="block text-sm text-slate-600 dark:text-slate-400">← Câu trước</span>
                <span class="mt-1 block font-semibold">{previousEntry.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            nextEntry ? (
              <a
                href={`/interview/${nextEntry.id}`}
                class="rounded-lg border border-slate-200 p-4 text-right outline-offset-4 hover:border-cyan-500 hover:bg-cyan-50 focus-visible:outline-2 focus-visible:outline-cyan-600 dark:border-slate-800 dark:hover:border-cyan-400 dark:hover:bg-slate-900"
              >
                <span class="block text-sm text-slate-600 dark:text-slate-400">
                  Câu tiếp theo →
                </span>
                <span class="mt-1 block font-semibold">{nextEntry.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
        </nav>
      </article>

      {
        headings.length > 0 && (
          <aside class="lg:sticky lg:top-8 lg:self-start">
            <nav
              aria-labelledby="table-of-contents-title"
              class="border-l border-slate-200 pl-4 dark:border-slate-800"
            >
              <h2
                id="table-of-contents-title"
                class="text-sm font-semibold uppercase tracking-wide text-slate-900 dark:text-slate-100"
              >
                Mục lục
              </h2>
              <ol class="mt-3 space-y-2 text-sm text-slate-600 dark:text-slate-400">
                {headings.map((heading) => (
                  <li class:list={{ 'pl-3': heading.depth > 2 }}>
                    <a
                      href={`#${heading.slug}`}
                      class="rounded-sm outline-offset-4 hover:text-cyan-700 focus-visible:outline-2 focus-visible:outline-cyan-600 dark:hover:text-cyan-300"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }
    </div>
  </main>
</BaseLayout>

<style>
  .article-content :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .article-content :global(h3) {
    margin-top: 2rem;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .article-content :global(p),
  .article-content :global(li) {
    color: var(--color-slate-700);
    line-height: 1.75;
  }

  @media (prefers-color-scheme: dark) {
    .article-content :global(p),
    .article-content :global(li) {
      color: var(--color-slate-300);
    }
  }

  .article-content :global(p + p) {
    margin-top: 1.25rem;
  }

  .article-content :global(a) {
    color: var(--color-cyan-700);
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  @media (prefers-color-scheme: dark) {
    .article-content :global(a) {
      color: var(--color-cyan-300);
    }
  }
</style>
